  <link name="gripper_tip"/>

  <joint name="fixed" type="fixed">
    <parent link="world"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="gripper_r_joint1" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_r_link1"/>
    <origin xyz="0.025 0.0 0.0856" rpy="1.570796327 0.0 3.1415926535897931"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.0471975512" effort="100" velocity="1"/>
  </joint>

  <joint name="gripper_r_joint2" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_r_link2"/>
    <origin xyz="0.0115 0.0 0.1056" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 -1"/>
    <mimic joint="gripper_r_joint1" multiplier="1" offset="0"/>
    <limit lower="0" upper="1.0471975512" effort="100" velocity="1"/>
  </joint>

  <joint name="gripper_r_joint_finger" type="revolute">
    <parent link="gripper_r_link2"/>
    <child link="gripper_r_link_finger"/>
    <origin xyz="0.0 0.053 0.0" rpy="3.1415926535897931 0 3.1415926535897931"/>
    <axis xyz="0 0 -1"/>
    <mimic joint="gripper_r_joint1" multiplier="1" offset="0"/>
    <limit lower="0" upper="1.0471975512" effort="100" velocity="1"/>
  </joint>

  <joint name="gripper_l_joint1" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_l_link1"/>
    <origin xyz="-0.025 0.0 0.0856" rpy="1.570796327 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.0471975512" effort="100" velocity="1"/>
  </joint>

  <joint name="gripper_l_joint2" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="gripper_l_link2"/>
    <origin xyz="-0.0115 0.0 0.1056" rpy="1.570796327 0 3.1415926535897931"/>
    <axis xyz="0 0 -1"/>
    <mimic joint="gripper_l_joint1" multiplier="1" offset="0"/>
    <limit lower="0" upper="1.0471975512" effort="100" velocity="1"/>
  </joint>

  <joint name="gripper_l_joint_finger" type="revolute">
    <parent link="gripper_l_link2"/>
    <child link="gripper_l_link_finger"/>
    <origin xyz="0.0 0.053 0.0" rpy="3.1415926535897931 0 3.1415926535897931"/>
    <axis xyz="0 0 -1"/>
    <mimic joint="gripper_l_joint1" multiplier="1" offset="0"/>
    <limit lower="0" upper="1.0471975512" effort="100" velocity="1"/>
  </joint>

  <joint name="gripper_joint_tip" type="fixed">
    <parent link="gripper_l_link_finger"/>
    <child link="gripper_tip"/>
    <origin xyz="0.0115 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>
