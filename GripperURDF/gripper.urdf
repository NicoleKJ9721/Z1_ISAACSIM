  <link name="gripper_l_link1">
    <visual>
      <geometry>
        <mesh filename="meshes/gripper/visual/gripper_link1.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="meshes/gripper/collision/gripper_link1.stl"/>
