<?xml version="1.0"?>
<robot name="lebai_gripper">
  <material name="white">
    <color rgba="0.86 0.85 0.81 1.0"/>
  </material>

  <link name="world"/>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 9.26852226257e-06 -0.00775500207506" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="meshes/gripper/visual/gripper_base_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 9.26852226257e-06 -0.00775500207506" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="meshes/gripper/collision/gripper_base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_r_link1">
